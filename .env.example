# Nothing here is needed for the demo. Leave this file alone to run `cargo leptos watch`.

# Web: 1 = read live venue funding and 1Click dry quotes (no keys needed, still no funds move)
TRIMTAB_ONLINE=0

# Live keeper (`trimtab-keeper tick`). Testnet first.
TRIMTAB_NETWORK=testnet
TRIMTAB_VAULT=trimtab-vault.your-account.testnet
TRIMTAB_KEEPER=keeper.your-account.testnet
# NEAR_RPC=https://rpc.testnet.near.org
# 1 = actually send transactions via near-cli-rs (keychain-signed). Otherwise commands are printed only.
TRIMTAB_EXECUTE=0

# Mainnet only: hard cap is 100 USD, and the phrase must match exactly:
# TRIMTAB_MAX_NOTIONAL_USD=50
# TRIMTAB_MAINNET_CONFIRM="I accept real-money risk up to 50 USD"
